    ]
  },
  "design_conflicts": [
    {
      "id": "DC-01",
      "topic": "Successful pricing status",
      "scenario_source": "The October 16 design lists pricingStatus 1005 for AP-001.",
      "detailed_design": "The detailed Apply Pricing scenario guide records status 200 for DEV and notes that mainframe data may use 1005.",
      "treatment": "Accept 200 or 1005 as successful input status; assert response success separately. Confirm the environment-specific contract before narrowing this."
    },
    {
      "id": "DC-02",
      "topic": "Pricer type to schedule attribute",
      "scenario_source": "The PDF's MVP2 derivation text maps I to APC pricing and 64 to ASC pricing, but its schedule-attribute statements reverse APCOP/ASCOP.",
      "detailed_design": "Scenario descriptions map I to APCOP and 64 to ASCOP.",
      "treatment": "Do not assert a schedule attribute as an expected response field; check the request route and observable amounts only."
    },
    {
      "id": "DC-03",
      "topic": "OTROP/DRG live payload identity",
      "scenario_source": "The updated October 16 design expects OTROP-634 with group method 10/AR.",
      "bruno_payloads": "The referenced OTROP-634 payload is not in the current Bruno collection. Older 453 candidate payloads use group method 01/MS and are not substitutes.",
      "treatment": "Keep OTROP-634 in the 36-scenario catalog as Not Run until its matching payload is supplied; leave the older 453 request files unmapped."
    },
    {
      "id": "DC-04",
      "topic": "AP-015 over-allowed fixture",
      "scenario_source": "AP-015 requires allowed greater than billed and ovragCfg=Y.",
      "bruno_payloads": "The captured AP-015 request has no line with pdAllowed greater than chargeAmt and has ovragCfg=N.",
      "treatment": "Mark this execution Blocked by unmet scenario preconditions."
    },
    {
      "id": "DC-05",
      "topic": "Crosswalk fallback and error values",
      "scenario_source": "The detailed scenario guide expects ppoDiscReason 2002 for AP-045 and 7004 for AP-044 when the crosswalk ERROR_CD is positive.",
      "pricing_design": "The PDF describes fallback to PPO RNC and leaves PPN RNC values / some crosswalk rows unresolved.",
      "treatment": "Assert only the confirmed PCLM expectations; AP-044 remains conditional until an ERROR_CD-positive fixture is supplied."
    },
    {
      "id": "DC-06",
      "topic": "AP-SC18 all-excluded case rate",
      "scenario_source": "The updated scenario inventory includes AP-SC18 but leaves the expected behavior blank.",
      "detailed_design": "The supplementary scenario pack marks the all-excluded case-rate outcome TBD by the designer.",
      "treatment": "Include AP-SC18 in the catalog as design-pending and Not Run until approved behavior and a payload are available."
    },
    {
      "id": "DC-07",
      "topic": "AP-031 plan-limit fixture",
      "scenario_source": "AP-031 expects a planCoveredExpenseLimit of 2000 below billed 9000.",
      "bruno_payloads": "The current payload has plan limits of 2000 on lines billed 816.71 and 359, so it does not meet the described trigger.",
      "treatment": "Block the current execution on unmet input conditions. For a matching fixture, derive case-rate NC from the finite plan-limit basis and allowedCharges using the PDF rule."
    },
    {
      "id": "DC-08",
      "topic": "ASCOP evidence fixture",
      "scenario_source": "ASCOP expects direct ASC pricing with pricerType 64.",
      "bruno_payloads": "The current ASCOP with NC request uses pricerType S and groupMethod 10, so it does not exercise direct ASC pricing.",
      "treatment": "Keep it mapped for comparison but require pricerType 64 and groupMethod 02; the current payload is Blocked instead of counted as a pass."
    }
  ],
