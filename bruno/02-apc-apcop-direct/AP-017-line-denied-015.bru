tests {
  test("HTTP accepted", function () {
    expect([200, 202, 207]).to.include(res.getStatus());
  });
  test("does not gate 7011 when Line-Denied present", function () {
    const codes = (res.getBody().lineItems || []).map((l) => String(l.message.code));
    expect(codes).to.not.include("7011");
  });
  test("denied line NC = billed (1400)", function () {
    const l1 = res.getBody().lineItems.find((l) => l.lineNumber === "0001");
    expect(Number(l1.totalNotCoveredAmount)).to.equal(1400);
  });
  test("claimLevelGroupMethod AP", function () {
    expect(res.getBody().claimLevel.claimLevelGroupMethod).to.equal("AP");
  });
}

