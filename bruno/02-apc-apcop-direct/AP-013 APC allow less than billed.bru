tests {
  test("HTTP accepted", function () {
    expect([200, 202, 207]).to.include(res.getStatus());
  });
  test("claim message 200", function () {
    expect(String(res.getBody().message.code)).to.eql("200");
  });
  test("group method AP", function () {
    expect(res.getBody().claimLevel.claimLevelGroupMethod).to.eql("AP");
  });
  test("claim excess reconciles to line 0001 allowed-over-billed amount", function () {
    expect(res.getBody().claimLevel.claimLevelExcessAmount).to.be.closeTo(34.07, 0.02);
  });
  test("line not-covered amounts match extracted allowances", function () {
    expect(res.getBody().lineItems.slice(0, 3).map(line => Number(line.totalNotCoveredAmount))).to.eql([0, 67.5, 1000]);
  });
  test("claim not-covered total reconciles", function () {
    expect(res.getBody().claimLevel.claimLevelTotalNotCoveredAmount).to.be.closeTo(1067.5, 0.02);
  });
}

docs {
  Mainframe source: DATA-FROM -MAINFRAME/APCOP/AP-013-TEST DATA FROM MAINFRAME.yaml; doc=202612894390003; claimCcrKey=202612894390003_9432612890003; diagnosis=R6889.
  Service lines: 77063/00403 billed 20 allowed 54.07 (HSS,APC,PRICE; AP,SI-A); 80050/00320 billed 150 allowed 82.50 (HSS,APC,PRICE; A,SI-A); J1250/00636 billed 1000 allowed 0 (PACKAGED-P09; SI-N).
  Expected arithmetic: not-covered 0 + 67.50 + 1000 = 1067.50; excess 54.07 - 20 = 34.07. Override reason was not present in the supplied extract; verify it in the mainframe before treating this as a no-override test case.
}
