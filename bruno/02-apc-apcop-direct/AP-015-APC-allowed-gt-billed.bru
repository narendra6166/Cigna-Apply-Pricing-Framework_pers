tests {
  test("HTTP accepted", function () {
    expect([200, 202, 207]).to.include(res.getStatus());
  });
  test("claim message 200", function () {
    expect(String(res.getBody().message.code)).to.eql("200");
  });
  test("group method AP", function () {
    expect(res.getBody().claimLevel.claimLevelGroupMethod).to.eql("AP");
  });
  test("excess > 0", function () {
    expect(res.getBody().claimLevel.claimLevelExcessAmount).to.be.above(0);
  });
}

