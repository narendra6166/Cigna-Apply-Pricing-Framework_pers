tests {

  test("HTTP accepted", function () {
    expect([200, 202, 207]).to.include(res.getStatus());
  });
  test("not 7003", function () {
    const codes = (res.getBody().lineItems || []).map((l) => String(l.message && l.message.code));
    expect(codes).to.not.include("7003");
  });
}

