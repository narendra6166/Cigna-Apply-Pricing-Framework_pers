tests {

  test("HTTP accepted", function () {
    expect([200, 202, 207]).to.include(res.getStatus());
  });
  test("group method AR from groupMethod 10", function () {
    expect(res.getBody().claimLevel.claimLevelGroupMethod).to.eql("AR");
  });
}

