tests {

  test("HTTP accepted", function () {
    expect([200, 202, 207]).to.include(res.getStatus());
  });
  test("not 7011 when Denied is present", function () {
    expect(String(res.getBody().lineItems[0].message.code)).to.not.eql("7011");
  });
}

