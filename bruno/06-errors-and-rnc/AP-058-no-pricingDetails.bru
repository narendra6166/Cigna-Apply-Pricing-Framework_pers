tests {

  test("HTTP accepted", function () {
    expect([200, 202, 207]).to.include(res.getStatus());
  });
  test("no Apply Pricing gates 7010 7011 7012", function () {
    const items = res.getBody().lineItems || [];
    items.forEach(function (li) {
      expect(["7010", "7011", "7012"]).to.not.include(String(li.message.code));
    });
  });
}

