tests {

  test("HTTP accepted", function () {
    expect([200, 202, 207]).to.include(res.getStatus());
  });
  test("line 7004 when xwalk ERROR_CD > 0", function () {
    expect(String(res.getBody().lineItems[0].message.code)).to.eql("7004");
  });
}

